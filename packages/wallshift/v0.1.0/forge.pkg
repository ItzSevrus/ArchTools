[package]
name = "wallshift"
version = "0.1.0"
description = "Lightweight C++ wallpaper rotator for Wayland and Hyprland using awww"
license = "MIT"

[source]
url = "https://github.com/ItzSevrus/ArchTools/releases/download/wallshift-v0.1.0/wallshift-v0.1.0a.tar.gz"
checksum = "sha256:6505550fb74174e6e44bfc1b4b228414d25962de77fc0948aeb4820f548ba354"

[build]
script = "build.sh"
command = "./build.sh"
compilers = []

[dependencies]
runtime = []
build = []

[dependencies.system]
apt = ["cmake", "build-essential", "awww"]
pacman = ["cmake", "base-devel", "awww"]
dnf = ["cmake", "gcc-c++", "make", "awww"]
zypper = ["cmake", "gcc-c++", "make", "awww"]
