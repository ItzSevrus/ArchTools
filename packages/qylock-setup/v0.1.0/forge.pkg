[package]
name = "qylock-setup"
version = "0.1.0"
description = "A transparent, cross-distribution Bash installer for Qylock, the SDDM lock-screen theme collection by Darkkal44."
license = "MIT"

[source]
url = "https://github.com/ItzSevrus/ArchTools/releases/download/qylock-setup-v0.1.0/qylock-setup-v0.1.0.tar.gz"
checksum = "sha256:5c8f697045a1ffe7c73d487ad2e7e0d632b40d070911a16dc01b7472649b1f6c"

[build]
script = "build.sh"
command = "./build.sh"
compilers = ["c++"]

[dependencies]
runtime = []
build = []

[dependencies.system]
apt = []
