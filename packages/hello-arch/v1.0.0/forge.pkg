[package]
name = "hello-arch"
version = "1.0.0"
description = "A minimal example package"
license = "MIT"

[source]
url = "https://github.com/ItzSevrus/ArchTools/releases/download/hello-arch-v1.0.0/hello-arch-1.0.0.tar.gz"
checksum = "sha256:619c755c25fdcc0ebd0f8f164a73d80c7727628406c652375fa830571e6bd565"

[build]
script = "build.sh"
command = "./build.sh"
compilers = ["cc"]

[dependencies]
runtime = []
build = []

[dependencies.system]
apt = ["build-essential"]
pacman = ["base-devel"]
dnf = ["gcc", "make"]
zypper = ["gcc", "make"]
